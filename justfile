# NetherNode task runner. `just` lists recipes.

set shell := ["bash", "-euo", "pipefail", "-c"]

buf := "web/node_modules/.bin/buf"

# List recipes
default:
    @just --list

# Install frontend dependencies
setup:
    pnpm --dir web install --frozen-lockfile

# Run the backend (auto-restarting) and the Vite dev server with API proxy
dev:
    #!/usr/bin/env bash
    set -euo pipefail
    trap 'kill 0' EXIT
    export NETHERNODE_HTTP__BIND="${NETHERNODE_HTTP__BIND:-127.0.0.1:8080}"
    # Keep the dev proxy off the LAN unless asked otherwise.
    export NETHERNODE_PROXY__DEFAULT_LISTENER="${NETHERNODE_PROXY__DEFAULT_LISTENER:-127.0.0.1:25565}"
    cargo watch -q -w crates -w proto -x 'run -p nethernode -- serve' &
    pnpm --dir web dev &
    wait

# Lint protos and regenerate the TypeScript client (Rust code is generated by build.rs)
gen:
    pnpm --dir web gen

# Build the web UI and a release binary that embeds it: target/release/nethernode
build: setup
    pnpm --dir web build
    pnpm --dir web check:bundle
    cargo build --release --locked -p nethernode
    @echo "Built target/release/nethernode"

# Fast compile check of everything
check:
    cargo check --workspace --all-targets
    pnpm --dir web typecheck

# Run all tests
test:
    cargo test --workspace
    pnpm --dir web test

# Formatting, lints, proto lint, typecheck, contrast and raw-hex checks
lint:
    cargo fmt --all --check
    cargo clippy --workspace --all-targets -- -D warnings
    {{buf}} lint
    pnpm --dir web typecheck
    pnpm --dir web lint

# Format Rust and TypeScript
fmt:
    cargo fmt --all
    pnpm --dir web format

# Regenerate the sqlx offline query cache (.sqlx/) after changing queries or migrations
db-prepare:
    rm -f tmp/sqlx-prepare.db
    mkdir -p tmp
    DATABASE_URL=sqlite://tmp/sqlx-prepare.db sqlx database setup --source crates/nn-store/migrations
    DATABASE_URL=sqlite://tmp/sqlx-prepare.db cargo sqlx prepare --workspace

# Fuzz the pre-login protocol parser (needs nightly + cargo-fuzz)
fuzz seconds="600":
    cd crates/nn-mcproto && cargo +nightly fuzz run pre_login -- -max_total_time={{seconds}}

# Fuzz zip extraction: raw bytes and hostile entry names (needs nightly + cargo-fuzz)
fuzz-zip seconds="600":
    cd crates/nn-files && cargo +nightly fuzz run extract_entries -- -max_total_time={{seconds}}
    cd crates/nn-files && cargo +nightly fuzz run extract_raw -- -max_total_time={{seconds}}

# Fuzz the NBT reader and player-data mapping (needs nightly + cargo-fuzz)
fuzz-nbt seconds="600":
    cd crates/nn-players && cargo +nightly fuzz run nbt -- -max_total_time={{seconds}}

# Proxy benchmarks: routing micro-benchmark plus latency, throughput, and idle-memory load tests
bench-proxy:
    #!/usr/bin/env bash
    set -euo pipefail
    cargo bench -p nn-proxy --bench routing
    cargo build --release -p nn-proxy --examples
    T=target/release/examples
    $T/loadgen echo 127.0.0.1:25601 >/dev/null 2>&1 & echo_pid=$!
    $T/standalone 127.0.0.1:25600 127.0.0.1:25601 >/dev/null 2>&1 & proxy_pid=$!
    trap 'kill $proxy_pid $echo_pid 2>/dev/null' EXIT
    sleep 1
    $T/loadgen latency 127.0.0.1:25600 127.0.0.1:25601
    $T/loadgen throughput 127.0.0.1:25600 127.0.0.1:25601 1024
    $T/loadgen idle 127.0.0.1:25600 5000 8 & idle_pid=$!
    sleep 6
    echo "proxy RSS with 5000 idle connections: $(ps -o rss= -p $proxy_pid) KB"
    wait $idle_pid
