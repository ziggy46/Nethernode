# syntax=docker/dockerfile:1
# The release image: binaries built by .github/workflows/release.yml, copied
# per platform, so building the multi-arch image runs nothing under emulation.
#   context: a folder with nethernode-amd64 and nethernode-arm64
FROM alpine:3.22 AS certs

FROM scratch
ARG TARGETARCH
COPY --from=certs /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --chmod=0755 nethernode-${TARGETARCH} /nethernode
ENV NETHERNODE_DATA__DIR=/data \
    NETHERNODE_HTTP__BIND=0.0.0.0:8080
VOLUME ["/data"]
EXPOSE 8080 25565
ENTRYPOINT ["/nethernode"]
CMD ["serve"]
